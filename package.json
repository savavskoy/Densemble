{
  "name": "densemble",
  "version": "0.0.0",
  "private": true,
  "description": "Preproduction scaffold for a local Telegram and Copilot service.",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sdk:gate": "npm run build --silent && node dist/agents/sdk-gate/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@github/copilot": "1.0.91",
    "@github/copilot-sdk": "1.0.16",
    "better-sqlite3": "13.0.3",
    "grammy": "1.46.0",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
